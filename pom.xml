<?xml version="1.0" encoding="UTF-8"?>
<!--
============================================================
项目名称：AI-PPT（智能 PPT 生成与在线编辑平台）
项目描述：业务系统仓库 —— 平台能力（用户中心 / 文件服务 / 网关 /
        公共库）来自 cloud-platform 平台仓库

模块结构：
└── service            - 业务服务模块：
    ├── ai-service     - AI 服务：大模型接入、生图、文档转 PPT
    └── ppt-service    - PPT 服务：项目持久化、生成编排

依赖说明：
- 父 pom（com.exambaby:cloud）与公共库 common 来自平台仓库发布的
  GitHub Packages 制品，版本由父 pom 的 platform.libs.version 统一管理
- 用户中心 / 文件服务 / 统一网关由平台统一部署，本仓库不包含其代码
============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== 父工程（平台仓库发布） ==================== -->
    <!-- relativePath 置空：始终从制品仓库解析父 pom，而不是本地相对路径 -->
    <parent>
        <groupId>com.exambaby</groupId>
        <artifactId>cloud</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <!-- ==================== 项目坐标 ==================== -->
    <!-- 版本继承平台父 pom；业务仓库不单独发布制品 -->
    <artifactId>ai-ppt</artifactId>
    <packaging>pom</packaging>

    <!-- ==================== 子模块 ==================== -->
    <modules>
        <module>service</module>
    </modules>
</project>

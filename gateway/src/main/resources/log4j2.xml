<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%style{%d{yyyy-MM-dd HH:mm:ss.SSS}}{dim} %highlight{%-5level}{FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=dim green, TRACE=dim} %style{[%t]}{cyan} %style{%-40.40c{39}}{blue} : %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}" disableAnsi="false" noConsoleNoAnsi="false"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>

        <!-- Nacos 客户端日志级别 -->
        <Logger name="com.alibaba.nacos" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Spring 框架日志级别 -->
        <Logger name="org.springframework" level="warn"/>
        <Logger name="org.springframework.cloud.gateway" level="debug"/>

        <!-- 项目日志级别 -->
        <Logger name="com.exambaby" level="debug"/>
    </Loggers>
</Configuration>
